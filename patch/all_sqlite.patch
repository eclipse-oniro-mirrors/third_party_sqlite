+CODEC_STATIC int sqlite3CodecGetDbIndex(sqlite3 *db, const char *zDb){
+  int nDbIndex;
+  if(zDb == NULL){
+    return 0;
+  }
+  for(nDbIndex = 0; nDbIndex < db->nDb; nDbIndex++){
+    const char *zDbSName = db->aDb[nDbIndex].zDbSName;
+    if(strcmp(zDbSName, zDb) == 0){
+      return nDbIndex;
+    }
+  }
+  return 0;
+}

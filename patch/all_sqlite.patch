+int sqlite3QCacheEntrySetTtlcycle(const char *zTimeStr)
+{
+    if (!zTimeStr) {
+        return SQLITE_OK;
+    }
+
+    QCacheEntry *entry = sqlite3QCacheGetProcessEntry();
+    if (!entry || entry->inAccessible) {
+        return SQLITE_OK;
+    }
+
+    u32 invalidPeriod = 0;
+    if (QCacheStr2UintSafe(zTimeStr, (u32 *)&invalidPeriod) == SQLITE_OK) {
+        entry->ttlCycle = invalidPeriod;
+    }
+
+    return SQLITE_OK;
+}
+
+int sqlite3QCacheEntryCreateBySize(sqlite3 *db, const char *cacheSize)
+{
+    if (!db || !cacheSize) {
+        return SQLITE_OK;
+    }
+
+    u32 cacheFileSizeKB = 0;
+    if (QCacheStr2UintSafe(cacheSize, (u32 *)&cacheFileSizeKB) != SQLITE_OK) {
+        return SQLITE_ERROR;
+    }
+    u32 cacheFileSizeBytes = QCACHE_ALIGN_UP_TO_4KB_BYTES(cacheFileSizeKB);
+
+    int ret = SQLITE_OK;
+    QCacheEntry *entry = sqlite3QCacheGetProcessEntry();
+    if (!entry) {
+        ret = qCacheCreateProcessEntry(db, cacheFileSizeBytes, &entry);
+        if (ret != SQLITE_OK) {
+            sqlite3_log(ret, "sqlite3QCacheEntryCreateBySize(): qCacheCreateProcessEntry.");
+            return ret;
+        }
+        return SQLITE_OK;
+    }
+    sqlite3_log(SQLITE_ERROR, "[sqlite][qcache] sqlite query create entry by size %u.", cacheFileSizeBytes);
+    if (entry->cacheFileSize >= cacheFileSizeBytes || !entry->inAccessible) {
+        entry->inAccessible = 0;
+        return SQLITE_OK;
+    }
+
+    return qCacheRebuildProcessEntry(entry, cacheFileSizeBytes);
+}
+
+int sqlite3QCacheServiceCtrl(sqlite3 *db, const char *enableStr)
+{
+    if (!db || !enableStr) {
+        return SQLITE_OK;
+    }
+
+    u32 enableFlag = 0;
+    if (QCacheStr2UintSafe(enableStr, (u32 *)&enableFlag) != SQLITE_OK) {
+        return SQLITE_ERROR;
+    }
+
+    enableFlag = (enableFlag > 0) ? 1 : 0;
+    QCacheEntry *entry = sqlite3QCacheGetProcessEntry();
+    if ((enableFlag && entry) || (!enableFlag && (!entry))) {
+        return SQLITE_OK;
+    }
+
+    if (enableFlag) {
+        return qCacheCreateProcessEntry(db, 0, &entry);
+    }
+
+    return sqlite3QCacheCloseProcessEntry();
+}
+
+int sqlite3QCacheServiceDebug(const char *enableStr, QCacheVersion *version)
+{
+    if (!enableStr || !version) {
+        return SQLITE_OK;
+    }
+
+    QCacheEntry *entry = sqlite3QCacheGetProcessEntry();
+    if (!entry) {
+        sqlite3_log(SQLITE_MISUSE, "sqlite3QCacheServiceDebug(): sqlite3QCacheGetProcessEntry.");
+        return SQLITE_MISUSE;
+    }
+
+    u32 enableFlag = 0;
+    if (QCacheStr2UintSafe(enableStr, (u32 *)&enableFlag) != SQLITE_OK) {
+        return SQLITE_ERROR;
+    }
+
+    if (enableFlag <= 0) {
+        return SQLITE_OK;
+    }
+
+    if (enableFlag == HOTSQL_DELE_ALL_CODE) {
+        return qCacheEntryHandleByType(entry, QCACHE_MSG_DELETE_ALL, version);
+    }
+
+    return qCacheEntryHandleByType(entry, QCACHE_MSG_DEBUG, version);
+}
+
+int sqlite3QCacheServiceInfo(const char *enableStr, QCacheVersion *version)
+{
+    if (!enableStr) {
+        return SQLITE_OK;
+    }
+
+    QCacheEntry *entry = sqlite3QCacheGetProcessEntry();
+    if (!entry) {
+        sqlite3_log(SQLITE_MISUSE, "sqlite3QCacheServiceInfo(): sqlite3QCacheGetProcessEntry.");
+        return SQLITE_MISUSE;
+    }
+
+    u32 enableFlag = 0;
+    if (QCacheStr2UintSafe(enableStr, (u32 *)&enableFlag) != SQLITE_OK) {
+        return SQLITE_ERROR;
+    }
+
+    if (enableFlag <= 0) {
+        return SQLITE_OK;
+    }
+
+    return qCacheEntryHandleByType(entry, QCACHE_MSG_INFO, version);
+}

+    Btree *pBt = db->aDb[0].pBt;
+    if (!pBt) {
+        return 0;
+    }
+
+    Pager *pPager = sqlite3BtreePager(pBt);
+    if (!pPager) {
+        return 0;
+    }
+
+    if (pPager->pWal) {
+        return QCacheGetChangeCounterWAL(pPager, chgCounter);
+    }
+
+    return QCacheGetChangeCounterFromFile(pBt, pPager, chgCounter);
+}

+  openssl_init_count--;
+  if(openssl_init_count == 0){
+    if(openssl_external_init_flag){
+      openssl_external_init_flag = 0;
+    }else{
+      EVP_cleanup();
+    }
+  }
+
+  sqlite3_mutex_leave(sqlite3_mutex_alloc(SQLITE_MUTEX_STATIC_MASTER));
+  return;
+}

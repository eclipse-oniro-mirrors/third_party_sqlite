+  if(openssl_random_mutex == NULL){
+    openssl_random_mutex = sqlite3_mutex_alloc(SQLITE_MUTEX_FAST);
+  }
+  openssl_init_count++;
+
+  sqlite3_mutex_leave(sqlite3_mutex_alloc(SQLITE_MUTEX_STATIC_MASTER));
+  return;
+}

+/*
+** Handler for PRAGMA hot_sql_register and PRAGMA hot_sql_unregister
+** zLeft:  Name of the PRAGMA (hot_sql_register / hot_sql_unregister)
+** zRight: SQL statement string to register or unregister from query cache
+**
+** Return non-zero if the pragma is recognized and processed.
+*/
+int PragmaHotSql(sqlite3 *db, Parse *pParse, const char *zLeft, const char *zRight)
+{
+    if (!db || !zLeft || !zRight) {
+        return SQLITE_OK;
+    }

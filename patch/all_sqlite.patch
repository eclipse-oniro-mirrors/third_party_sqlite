+CODEC_STATIC void sqlite3CodecSetError(CodecContext *ctx, int error){
+  if(ctx->pBt){
+    ctx->pBt->pBt->pPager->errCode = error;
+    ctx->pBt->pBt->pPager->eState = PAGER_ERROR;
+    ctx->pBt->pBt->db->errCode = error;
+  }
+  return;
+}

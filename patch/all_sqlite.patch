+/*
+ * Retrieve WAL salt1/salt2 from a database connection.
+ *
+ * Results:
+ *   1 if the database is in WAL mode and salts are obtained successfully.
+ *   0 otherwise (not WAL or error).
+ */
+int sqlite3QCacheGetWALSalt(sqlite3 *db, u32 *salt1, u32 *salt2)
+{
+    /* Basic sanity checking */
+    if (!db || !salt1 || !salt2) {
+        return 0;
+    }
+
+    Btree *pBt = db->aDb[0].pBt;
+    if (!pBt) {
+        return 0;
+    }
+
+    Pager *pPager = sqlite3BtreePager(pBt);
+    if (!pPager) {
+        return 0;
+    }
+
+    return sqlite3PagerGetWalSalt(pPager, salt1, salt2);
+}
+
+int sqlite3QCacheGetSchemaCookie(sqlite3 *db, u32 *schemaCookie)
+{
+    if (!db) {
+        return 0;
+    }
+
+    Schema *pS = db->aDb[0].pSchema;
+    if (pS == NULL) {
+        return 0;
+    }
+
+    Btree *pBt = db->aDb[0].pBt;
+    if (!pBt) {
+        return 0;
+    }
+
+    // fromDb==0: use in-memory value if available
+    int rc = SQLITE_OK;
+    int openedTransaction = 0;
+    if (sqlite3BtreeTxnState(pBt) == SQLITE_TXN_NONE) {
+        rc = sqlite3BtreeBeginTrans(pBt, 0, 0);
+        if (rc != SQLITE_OK) {
+            return rc;
+        }
+        openedTransaction = 1;
+    }
+
+    sqlite3BtreeGetMeta(pBt, BTREE_SCHEMA_VERSION, schemaCookie);
+
+    if (openedTransaction) {
+        sqlite3BtreeCommit(pBt);
+    }
+
+    return SQLITE_OK;
+}
+
+static int QCacheGetChangeCounterFromFile(Btree *pBt, Pager *pPager, u32 *chgCounter)
+{
+    int rc = 0;
+    sqlite3BtreeEnter(pBt);
+
+    if (pPager->fd == NULL) {
+        rc = 0;
+        goto end;
+    }
+    sqlite3_file *fd = pPager->fd;
+    u8 pageBuf[100] = {0};
+    rc = sqlite3OsRead(fd, pageBuf, sizeof(pageBuf), 0);
+    if (rc != SQLITE_OK) {
+        rc = 0;
+        goto end;
+    }
+
+    char dbFileVers[16];
+    memcpy(dbFileVers, &pageBuf[24], 16);
+    *chgCounter = sqlite3Get4byte((u8*)dbFileVers);
+    rc = 1;
+
+end:
+    sqlite3BtreeLeave(pBt);
+    return rc;
+}
+
+int QCacheGetChangeCounterWAL(Pager *pPager, u32 *pChangeCounter)
+{
+    if( !pPager || !pPager->pWal ){
+        return SQLITE_ERROR;
+    }
+
+    Wal *pWal = pPager->pWal;
+
+    *pChangeCounter = pWal->hdr.iChange;
+    return SQLITE_OK;
+}
+
+int sqlite3QCacheGetChangeCounter(sqlite3 *db, u32 *chgCounter)
+{
+    if (!db || !chgCounter) {
+        return 0;
+    }

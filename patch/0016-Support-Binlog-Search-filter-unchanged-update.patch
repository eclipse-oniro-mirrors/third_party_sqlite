+/*
+** Per-table union of SET-column names of all UPDATE statements coded into
+** one prepared statement (the main statement plus any trigger steps or FK
+** actions).  Built at codegen time on the TOP-LEVEL Vdbe, consumed at
+** runtime by CheckNeedNotify()/CheckNeedNotifyForUpdate() to decide whether
+** a row event must raise a data-change notification.
+**
+** One entry per table.  When several statements in the same program update
+** the same table, their SET lists are UNION-merged, so the entry is always
+** a superset of the SET list of whichever statement is executing.  The
+** exact old-vs-new value comparison in CheckNeedNotifyForUpdate() remains
+** the final arbiter, so a superset never loses nor fakes a notification.
+*/
+typedef struct BinlogTabChangedCols BinlogTabChangedCols;
+struct BinlogTabChangedCols {
+  Table *pTab;      /* key: schema Table object (pointer identity) */
+  char **azCol;     /* union of SET column names (sqlite3DbStrDup'd) */
+  int nCol;         /* used slots in azCol[] */
+  int nAlloc;       /* allocated slots in azCol[] */
+};
+SQLITE_PRIVATE void sqlite3BinlogAddChangedCols(Parse *pParse, Table *pTab,
+                                                const int *aXRef);
+SQLITE_PRIVATE void sqlite3FreeTabChangedCols(Vdbe *p);
+SQLITE_PRIVATE void sqlite3ClearBinlogRuntimeState(Vdbe *p);
 /************** Binlog typedef in sqlite3 END ************************************/
 #endif
 

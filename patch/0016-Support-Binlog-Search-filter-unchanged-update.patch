+/* Set-columns recorded at codegen time for pTab in this program, or NULL
+** when unknown (table not UPDATEd by this program, statement coded before
+** ROW_FOR_SEARCH was enabled, upsert DO UPDATE path, ...). */
+static BinlogTabChangedCols *FindTabChangedCols(Vdbe *p, const Table *pTab){
+  int i;
+  for(i=0; i<p->nTabChangedCols; i++){
+    if( p->aTabChangedCols[i].pTab==pTab ) return &p->aTabChangedCols[i];
+  }
+  return NULL;
+}

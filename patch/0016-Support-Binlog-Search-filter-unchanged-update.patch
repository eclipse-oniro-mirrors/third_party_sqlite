+SQLITE_PRIVATE int CheckNeedNotify(Vdbe *p, Table *pTab){
+  if (pTab==NULL || pTab->zName==NULL) {
+    return 0;
+  }
+  MonitorTableCol *tableConfig = FindMonitorTableConfig(p, pTab->zName);
+  if (tableConfig == NULL) {
+    return 0;
+  }
+  if (p->isInsertOrDelete) {
+    return 1;
+  }
+  BinlogTabChangedCols *pCh = FindTabChangedCols(p, pTab);
+  if (pCh == NULL) {
+    /* SET columns unknown: conservative notify (exact value comparison is
+    ** not possible on this fallback path). */
+    return 1;
+  }
+  return BinlogColsIntersect(pCh->azCol, pCh->nCol, tableConfig);
+}
+
+/* Type + byte-exact comparison: any difference (including storage type
+** change, e.g. int 1 -> real 1.0) counts as "changed" (conservative). */
+static int BinlogValueEqual(sqlite3_value *pOld, sqlite3_value *pNew){
+  int t = sqlite3_value_type(pOld);
+  if( t!=sqlite3_value_type(pNew) ) return 0;
+  if( t==SQLITE_NULL ) return 1;
+  if( t==SQLITE_INTEGER ) return sqlite3_value_int64(pOld)==sqlite3_value_int64(pNew);
+  if( t==SQLITE_FLOAT ) return sqlite3_value_double(pOld)==sqlite3_value_double(pNew);
+  if( sqlite3_value_bytes(pOld)!=sqlite3_value_bytes(pNew) ) return 0;
+  return sqlite3_value_bytes(pOld)==0
+    || memcmp(sqlite3_value_blob(pOld), sqlite3_value_blob(pNew),
+              sqlite3_value_bytes(pOld))==0;
+}
+
+/* Check whether an UPDATE row needs the notify flag, by comparing the old
+** and new values of the monitored columns. The value comparison only runs
+** on the main update path of rowid tables: the cursor must still point at
+** the old row. In chngKey / FK forced delete+insert cases OP_Delete already
+** removed the old row, so the guard falls back to CheckNeedNotify (which
+** notifies conservatively). */
+SQLITE_PRIVATE int CheckNeedNotifyForUpdate(Vdbe *p, Table *pTab,
+  BtCursor *pCursor, const BinlogRow *pRow){
+  sqlite3 *db = p->db;
+  MonitorTableCol *tc = FindMonitorTableConfig(p, pTab->zName);
+  if( tc==NULL ) return 0;
+
+  /* SET columns of the UPDATE that produced this row event.  NULL means
+  ** "unknown" (statement coded before ROW_FOR_SEARCH was enabled, upsert
+  ** DO UPDATE path, OOM during codegen, ...): skip both filters below and
+  ** let the exact old-vs-new value comparison decide. */
+  BinlogTabChangedCols *pCh = FindTabChangedCols(p, pTab);
+
+  /* Fast path: SET columns known and disjoint from the monitored columns
+  ** -> no monitored value can change -> no notify, skip the old-row read. */
+  if( pCh!=NULL
+   && !BinlogColsIntersect(pCh->azCol, pCh->nCol, tc) ) return 0;
+
+  /* Guard: cursor must still point at the OLD row being updated.
+  ** In chngKey/hasFK>1 cases OP_Delete already removed the old row and the
+  ** cursor moved elsewhere (or is invalid) -> fall back to legacy logic. */
+  if( !sqlite3BtreeCursorIsValidNN(pCursor)
+   || sqlite3BtreeIntegerKey(pCursor)!=pRow->rowid ){
+    return CheckNeedNotify(p, pTab);
+  }
+
+  /* Read the old record from the b-tree (same pattern as OP_Delete binlog
+  ** block). OOM or empty payload -> legacy fallback. */
+  u32 nOld = sqlite3BtreePayloadSize(pCursor);
+  char *pOld = nOld>0 ? sqlite3DbMallocRaw(db, nOld) : NULL;
+  if( pOld==NULL ) return CheckNeedNotify(p, pTab);
+  sqlite3BtreePayload(pCursor, 0, nOld, pOld);
+
+  /* New record: if it has a zero-filled tail (MEM_Zero), build a padded
+  ** buffer like sqlite3BinlogGetNthCol does; else use pData directly. */
+  const char *pNew = pRow->pData;
+  char *pNewBuf = NULL;
+  u64 nNew = pRow->nData + (u64)pRow->nZero;
+  if( pNew==NULL ){
+    sqlite3DbFree(db, pOld);
+    return CheckNeedNotify(p, pTab);
+  }
+  if( pRow->nZero>0 ){
+    pNewBuf = sqlite3MallocZero(nNew);
+    if( pNewBuf==NULL ){
+      sqlite3DbFree(db, pOld);
+      return CheckNeedNotify(p, pTab);
+    }
+    errno_t errNo = memcpy_s(pNewBuf, (size_t)nNew, pNew, (size_t)pRow->nData);
+    if( errNo!=EOK ){
+      sqlite3_free(pNewBuf);
+      sqlite3DbFree(db, pOld);
+      return CheckNeedNotify(p, pTab);
+    }
+    pNew = pNewBuf;
+  }
+
+  int needNotify = 0;
+  for(int k=0; k<tc->colCount && !needNotify; k++){
+    /* Column filter applies only when the SET list is known; with unknown
+    ** SET compare every monitored column. */
+    if( pCh!=NULL
+     && !BinlogColInChangedCols(pCh->azCol, pCh->nCol, tc->cols[k]) ){
+      continue;
+    }
+    int iCol = sqlite3ColumnIndex(pTab, tc->cols[k]);
+    if( iCol<0 ) continue;                          /* stale config col */
+    if( HasRowid(pTab) && iCol==pTab->iPKey ) continue; /* rowid alias: unchanged
+                                                      ** (guaranteed by guard above) */
+    sqlite3_value *pOldVal = NULL;
+    sqlite3_value *pNewVal = NULL;
+    int rcOld = sqlite3BinlogStat4Column(db, pOld, (int)nOld, iCol, &pOldVal);
+    int rcNew = sqlite3BinlogStat4Column(db, pNew, (int)nNew, iCol, &pNewVal);
+    if( rcOld!=SQLITE_OK || rcNew!=SQLITE_OK
+     || !BinlogValueEqual(pOldVal, pNewVal) ){
+      needNotify = 1;   /* decode failure (old row pre-ALTER / virtual
+                        ** generated col etc.) -> conservative notify */
+    }
+    sqlite3ValueFree(pOldVal);
+    sqlite3ValueFree(pNewVal);
+  }
+  sqlite3DbFree(db, pOld);
+  sqlite3_free(pNewBuf);
+  return needNotify;
+}

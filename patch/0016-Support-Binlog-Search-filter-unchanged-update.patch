+/*
+** Record the SET-column list of the UPDATE currently being coded into the
+** top-level Vdbe, keyed by pTab.  Called from sqlite3Update() for both the
+** main statement (pParse is the top-level parse) and trigger steps / FK
+** actions (pParse is a sub-parse; sqlite3ParseToplevel() reaches the
+** top-level parse).  In both cases the entry lands on the one Vdbe that
+** actually executes the program.
+**
+** Existing entries for the same table are UNION-merged (column names
+** de-duplicated).  OOM: sqlite3DbRealloc/sqlite3DbStrDup failure sets
+** db->mallocFailed, the prepare fails, and the partially built Vdbe and
+** map are discarded by sqlite3VdbeClearObject() - a partially filled
+** entry therefore never executes.
+*/
+SQLITE_PRIVATE void sqlite3BinlogAddChangedCols(
+  Parse *pParse,          /* parse of the UPDATE being coded */
+  Table *pTab,            /* table being updated */
+  const int *aXRef        /* aXRef[i]>=0 -> column i is in the SET clause */
+){
+  sqlite3 *db = pParse->db;
+  Vdbe *pTopV = sqlite3ParseToplevel(pParse)->pVdbe;
+  BinlogTabChangedCols *pEnt = 0;
+  int i;
+
+  if( pTopV==0 ) return;
+
+  for(i=0; i<pTopV->nTabChangedCols; i++){
+    if( pTopV->aTabChangedCols[i].pTab==pTab ){
+      pEnt = &pTopV->aTabChangedCols[i];
+      break;
+    }
+  }
+  if( pEnt==0 ){
+    BinlogTabChangedCols *aNew = (BinlogTabChangedCols*)sqlite3DbRealloc(
+        db, pTopV->aTabChangedCols,
+        (pTopV->nTabChangedCols+1)*sizeof(BinlogTabChangedCols)
+    );
+    if( aNew==0 ) return;                  /* OOM: prepare will fail */
+    pTopV->aTabChangedCols = aNew;
+    pEnt = &aNew[pTopV->nTabChangedCols];
+    memset(pEnt, 0, sizeof(*pEnt));
+    pEnt->pTab = pTab;
+    pTopV->nTabChangedCols++;
+  }
+
+  for(i=0; i<pTab->nCol; i++){
+    const char *zCn;
+    if( aXRef[i]<0 ) continue;   /* includes generated cols (aXRef==99999) */
+    zCn = pTab->aCol[i].zCnName;
+    if( BinlogColInChangedCols(pEnt->azCol, pEnt->nCol, zCn) ) continue;
+    if( pEnt->nCol>=pEnt->nAlloc ){
+      char **azNew = (char**)sqlite3DbRealloc(db, pEnt->azCol,
+          (pEnt->nAlloc+4)*sizeof(char*));
+      if( azNew==0 ) return;                /* OOM: prepare will fail */
+      pEnt->azCol = azNew;
+      pEnt->nAlloc += 4;
+    }
+    pEnt->azCol[pEnt->nCol] = sqlite3DbStrDup(db, zCn);
+    if( pEnt->azCol[pEnt->nCol]==0 ) return;/* OOM: prepare will fail */
+    pEnt->nCol++;
   }
-  for (int i=0; i<p->changedColsCount; i++) {
-    sqlite3DbFree(db, p->changedCols[i]);
-    p->changedCols[i] = NULL;
+}
+
+/*
+** Reset per-EXECUTION binlog runtime state.  Called from
+** sqlite3VdbeReset(), i.e. after every run of the statement.  Must NOT
+** touch aTabChangedCols: that map is codegen data required by every
+** (re-)execution of the prepared statement.
+*/
+SQLITE_PRIVATE void sqlite3ClearBinlogRuntimeState(Vdbe *p){
+  p->isInsertOrDelete = 0;
+}
+
+/*
+** Free the codegen-time per-table changed-columns map.  Called only from
+** sqlite3VdbeClearObject(), i.e. when the statement is finalized or
+** deleted.  (Historical note: the old FreeChangedCols() was also called
+** from sqlite3VdbeReset(), which destroyed the codegen-time changedCols
+** after the first execution - a re-executed prepared UPDATE silently
+** stopped notifying.  This split fixes that.)
+*/
+SQLITE_PRIVATE void sqlite3FreeTabChangedCols(Vdbe *p){
+  sqlite3 *db = p->db;
+  int i, j;
+  for(i=0; i<p->nTabChangedCols; i++){
+    BinlogTabChangedCols *pEnt = &p->aTabChangedCols[i];
+    for(j=0; j<pEnt->nCol; j++){
+      sqlite3DbFree(db, pEnt->azCol[j]);
+    }
+    sqlite3DbFree(db, pEnt->azCol);
   }
-  sqlite3DbFree(db, p->changedCols);
-  p->changedCols = NULL;
-  p->changedColsCount = 0;
+  sqlite3DbFree(db, p->aTabChangedCols);
+  p->aTabChangedCols = 0;
+  p->nTabChangedCols = 0;
 }
 #endif
 
@@ -93365,7 +93474,7 @@ SQLITE_PRIVATE int sqlite3VdbeReset(Vdbe *p){
   }
 #endif
 #ifdef SQLITE_ENABLE_BINLOG
-  FreeChangedCols(p);
